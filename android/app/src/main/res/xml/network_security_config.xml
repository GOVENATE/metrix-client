<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Ingestion is HTTPS only (https://tracking.soymetrix.com/gps/osmand/),
         so cleartext HTTP is blocked everywhere and the platform trust store
         (which includes the Let's Encrypt anchor) validates the server cert. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
